
---
const projects = [
  {
    title: "Cookie Cats A/B Testing",
    description: "Analyzed player retention and game engagement to evaluate the impact of changing progression gates.",
    tools: "Python • SQL • Statistics",
  },
  {
    title: "Telecom Customer Churn Analysis",
    description: "Explored customer behavior and churn patterns to identify potential drivers of customer attrition.",
    tools: "SQL • Python • Data Analysis",
  },
  {
    title: "Online Retail Sales Analysis",
    description: "Cleaned and analyzed retail transactions to investigate sales trends and business performance.",
    tools: "Python • Excel • Power BI",
  },
  {
    title: "Sales Performance Dashboard",
    description: "Developed an interactive dashboard to visualize sales, profit, and performance across regions.",
    tools: "Power BI • DAX • Visualization",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Data analytics portfolio featuring projects in Python, SQL, statistics, and Power BI." />
    <title>Robert Dutt | Data Analytics Portfolio</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="#home" class="logo">Robert Dutt</a>
        <div class="nav-links">
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" id="home">
        <p class="eyebrow">WELCOME TO MY PORTFOLIO</p>
        <h1>Hi, I'm Robert.</h1>
        <h2>Mathematics Student & Aspiring Data Analyst</h2>
        <p class="intro">
          I use mathematics, statistics, and programming to
          analyze data, discover patterns, and solve problems.
        </p>
        <a href="#projects" class="button">Explore My Projects →</a>
      </section>

      <section id="projects">
        <p class="eyebrow">MY WORK</p>
        <h2>Featured Projects</h2>
        <p class="section-description">
          A selection of projects demonstrating my experience
          with data analysis, statistics, and visualization.
        </p>

        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="tools">{project.tools}</span>
            </article>
          ))}
        </div>
      </section>

      <section id="about">
        <p class="eyebrow">BACKGROUND</p>
        <h2>About Me</h2>
        <p>
          I'm a mathematics student at Lehigh University with
          an interest in statistics, data analytics, and
          extracting meaningful insights from data.
        </p>
        <p>
          My technical experience includes Python, SQL, R,
          Excel, and Power BI. Through academic coursework and
          personal projects, I have developed skills in
          statistical analysis, data cleaning, and visualization.
        </p>
      </section>

      <section id="contact">
        <p class="eyebrow">GET IN TOUCH</p>
        <h2>Contact</h2>
        <p>
          I'm interested in opportunities in data analytics,
          business intelligence, and data science.
        </p>
        <p>
          Add your email, GitHub, and LinkedIn links here.
        </p>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Robert Dutt</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1120;
    color: #f1f5f9;
    line-height: 1.7;
  }

  header {
    border-bottom: 1px solid #263249;
  }

  nav {
    max-width: 1100px;
    margin: auto;
    padding: 22px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .logo {
    font-weight: bold;
    font-size: 20px;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav-links a:hover {
    color: #38bdf8;
  }

  main {
    max-width: 1100px;
    margin: auto;
    padding: 0 24px;
  }

  section {
    padding: 90px 0;
  }

  .hero {
    min-height: 530px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .eyebrow {
    color: #38bdf8;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(45px, 8vw, 78px);
    margin: 8px 0;
    line-height: 1.15;
  }

  h2 {
    font-size: clamp(25px, 4vw, 36px);
    line-height: 1.3;
  }

  .hero h2 {
    color: #94a3b8;
    margin: 12px 0;
  }

  .intro, .section-description {
    max-width: 650px;
    color: #94a3b8;
  }

  .button {
    background: #38bdf8;
    color: #07111e;
    font-weight: bold;
    padding: 12px 22px;
    border-radius: 8px;
    margin-top: 24px;
    display: inline-block;
  }

  .button:hover {
    background: #7dd3fc;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 36px;
  }

  .project-card {
    padding: 28px;
    background: #172338;
    border: 1px solid #29374d;
    border-radius: 12px;
  }

  .project-card h3 {
    font-size: 22px;
    margin-top: 0;
  }

  .project-card p {
    color: #94a3b8;
  }

  .tools {
    color: #38bdf8;
    font-size: 14px;
  }

  #about p, #contact p {
    max-width: 750px;
    color: #cbd5e1;
  }

  footer {
    padding: 24px;
    text-align: center;
    color: #94a3b8;
    border-top: 1px solid #263249;
  }

  @media (max-width: 650px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    nav {
      flex-direction: column;
    }

    section {
      padding: 65px 0;
    }
  }
</style>
